{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gyliber.dev/schemas/security-intruder/authentication-campaign-v1.json",
  "title": "GyLiber Security Intruder Synthetic Authentication Campaign v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "campaign_version",
    "target_id",
    "test_case_id",
    "probe"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "campaign_id": { "type": "string", "minLength": 1 },
    "campaign_version": { "type": "integer", "minimum": 1 },
    "target_id": { "type": "string", "minLength": 1 },
    "test_case_id": { "type": "string", "minLength": 1 },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "candidate_url",
        "identity",
        "attempts",
        "expected_status",
        "expected_outcome"
      ],
      "properties": {
        "kind": { "const": "SYNTHETIC_LOGIN" },
        "candidate_url": { "type": "string", "format": "uri" },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actor_id", "credential_ref"],
          "properties": {
            "actor_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "credential_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          }
        },
        "attempts": { "type": "integer", "minimum": 1 },
        "expected_status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "expected_outcome": {
          "enum": ["AUTHENTICATED", "REJECTED", "LOCKED_OUT"]
        }
      }
    }
  }
}
